# Postgres (Railway: copy DATABASE_URL from the Postgres plugin; Vercel: use Neon/Supabase/Railway)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/folio"
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me"
# Optional: raises Google Books quota. Open Library needs no key.
GOOGLE_BOOKS_API_KEY=""
